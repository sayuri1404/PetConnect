{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PetConnect: Run Server",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "paw_api.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "env": {
                "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/petconnect"
            }
        }
    ]
}